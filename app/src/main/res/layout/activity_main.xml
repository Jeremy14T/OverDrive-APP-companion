<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <ScrollView
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="22dp"
            android:orientation="vertical">
            <Button
                android:id="@+id/returnToPanelButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:visibility="gone"
                android:background="@drawable/secondary_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/back_to_panel"
                android:textAllCaps="false"
                android:textColor="@color/white" />
            <!-- Shared, compact vertical identity for first setup and saved connections. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="80dp"
                    android:src="@drawable/app_logo_header"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_name" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:maxLines="2" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/onboarding_tagline"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Compact onboarding hero; the QR and URL are in ONE card below. -->
            <LinearLayout
                android:id="@+id/firstRunPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                android:background="@drawable/welcome_bg"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRIMER ACCESO"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textSize="10sp"
                    android:textColor="@color/accent" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/onboarding_welcome_title"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="@color/white" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/onboarding_welcome_message"
                    android:lineSpacingExtra="2dp"
                    android:textSize="13sp"
                    android:textColor="@color/muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/savedProfilesPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mis conexiones guardadas"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="19sp" />
                <TextView
                    android:id="@+id/startupModeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <LinearLayout
                    android:id="@+id/profileList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
                <Button
                    android:id="@+id/useLastButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/secondary_button"
                    android:text="Abrir la última usada al iniciar"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
                <Button
                    android:id="@+id/addQrButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/accent_button"
                    android:text="@string/scan_more_qr"
                    android:drawableStart="@drawable/ic_qr_code"
                    android:drawableTint="@color/surface"
                    android:drawablePadding="10dp"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/surface" />
                <Button
                    android:id="@+id/addManualButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/secondary_button"
                    android:text="+ Agregar URL manualmente"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- One unified entry card, auto-visible on first run, reused for add/edit. -->
            <LinearLayout
                android:id="@+id/manualForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/formTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nueva conexión"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/onboarding_form_hint"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <!-- Keep the QR glyph and label centered as a single click target. -->
                <LinearLayout
                    android:id="@+id/scanButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/accent_button"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/scan_qr">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_qr_code"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/scan_qr"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/surface"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/onboarding_manual_divider"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>
                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/input_bg"
                    android:hint="@string/onboarding_url_example"
                    android:inputType="textUri|textNoSuggestions"
                    android:singleLine="true"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/white"
                    android:textColorHint="@color/muted"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/providerInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/detected_chip_bg"
                    android:padding="11dp"
                    android:text="Túnel detectado"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:visibility="gone" />
                <!-- Visible only for verified Tailscale URLs or an explicit selection. -->
                <LinearLayout
                    android:id="@+id/tailscaleAdvice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/tailscale_advice_bg"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ⓘ  Antes de conectar con Tailscale"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Instala Tailscale en este mismo teléfono y mantenlo conectado a la red del vehículo."
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                    <Button
                        android:id="@+id/tailscaleHelpButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/secondary_button"
                        android:text="Abrir Tailscale"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/providerPicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selecciona el proveedor de este enlace"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                    <RadioGroup
                        android:id="@+id/providerGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">
                        <RadioButton
                            android:id="@+id/cloudflareOption"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:buttonTint="@color/accent"
                            android:text="Cloudflare"
                            android:textColor="@color/white" />
                        <RadioButton
                            android:id="@+id/zrokOption"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:buttonTint="@color/accent"
                            android:text="Zrok"
                            android:textColor="@color/white" />
                        <RadioButton
                            android:id="@+id/tailscaleOption"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:buttonTint="@color/accent"
                            android:text="Tailscale"
                            android:textColor="@color/white" />
                    </RadioGroup>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="@string/onboarding_name_label"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/connectionNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/input_bg"
                    android:hint="@string/onboarding_name_example"
                    android:inputType="textCapSentences"
                    android:maxLength="50"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="@color/muted" />
                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/accent_button"
                    android:text="Guardar y conectar"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/surface" />
                <Button
                    android:id="@+id/cancelEditButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/secondary_button"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Las conexiones se guardan solo en tu teléfono. La autenticación sigue siendo la original de OverDrive."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/webPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/surface">
        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <Button
            android:id="@+id/changeButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/secondary_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone"
            android:contentDescription="@string/settings_description"
            android:text="@string/connection_shortcut"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/white" />
        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="24dp">
            <ImageView
                android:layout_width="108dp"
                android:layout_height="72dp"
                android:src="@drawable/app_logo"
                android:contentDescription="@string/app_name" />
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:indeterminateTint="@color/accent" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="Conectando con OverDrive…"
                android:textColor="@color/white"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Esperando respuesta del vehículo"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/loadingProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:progressTint="@color/accent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="30dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ImageView
            android:layout_width="112dp"
            android:layout_height="76dp"
            android:src="@drawable/app_logo"
            android:contentDescription="@string/app_name" />
        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/connection_error_title"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/errorDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/connection_error_text"
            android:textColor="@color/muted"
            android:textSize="15sp" />
        <Button
            android:id="@+id/openTailscaleButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="23dp"
            android:background="@drawable/secondary_button"
            android:text="@string/open_tailscale"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:visibility="gone" />
        <Button
            android:id="@+id/retryButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/accent_button"
            android:textAllCaps="false"
            android:text="@string/retry"
            android:textColor="@color/surface" />
        <Button
            android:id="@+id/editButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/secondary_button"
            android:textAllCaps="false"
            android:text="@string/change_connection"
            android:textColor="@color/white" />
    </LinearLayout>
</FrameLayout>
