<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OverDriveCompanion" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.OverDriveCompanion.Scanner" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
